# Copie este arquivo para security.env, preencha os valores e restrinja a leitura:
#   cp security_example.env security.env
#   chmod 600 security.env
# Nao adicione nem remova variaveis: `make check` valida este contrato exatamente.

#### Ambiente
# A release externa usa o contrato de producao.
ENVIRONMENT=prod

#### Banco de dados da aplicacao SEI IA
DB_SEIIA_USER=
DB_SEIIA_PWD=

#### Solr
SOLR_USER=
SOLR_PASSWORD=

#### Airflow
AIRFLOW_POSTGRES_DB=
AIRFLOW_POSTGRES_USER=
AIRFLOW_AMQP_USER=
_AIRFLOW_WWW_USER_USERNAME=
_AIRFLOW_WWW_USER_PASSWORD=
AIRFLOW_POSTGRES_PASSWORD=
AIRFLOW_AMQP_PASSWORD=
# Gere com: openssl rand -hex 32
AIRFLOW__WEBSERVER__SECRET_KEY=

#### LiteLLM Proxy
# Chave apresentada por Assistente, ETL e checker ao proxy local. Ela libera as
# entradas do proxy, mas nao autentica o proxy no provedor de modelos.
# Gere com: printf 'sk-%s\n' "$(openssl rand -hex 32)"
LITELLM_PROXY_API_KEY=
# Modelos fisicos por tras dos aliases fixos (inclua o prefixo do provedor). Cada tier possui
# endpoint, chave e versao independentes; nao reutilize implicitamente outro tier.
LITELLM_STANDARD_MODEL=
LITELLM_STANDARD_API_BASE=
# Chave usada pelo proxy somente no provedor do modelo standard.
LITELLM_STANDARD_API_KEY=
# Opcional para provedores que nao usam versao de API.
LITELLM_STANDARD_API_VERSION=
LITELLM_MINI_MODEL=
LITELLM_MINI_API_BASE=
# Chave usada pelo proxy somente no provedor do modelo mini.
LITELLM_MINI_API_KEY=
# Opcional para provedores que nao usam versao de API.
LITELLM_MINI_API_VERSION=
LITELLM_NANO_MODEL=
LITELLM_NANO_API_BASE=
# Chave usada pelo proxy somente no provedor do modelo nano.
LITELLM_NANO_API_KEY=
# Opcional para provedores que nao usam versao de API.
LITELLM_NANO_API_VERSION=
LITELLM_EMBEDDING_MODEL=
LITELLM_EMBEDDING_API_BASE=
# Chave usada pelo proxy somente no provedor de embeddings.
LITELLM_EMBEDDING_API_KEY=
# Opcional para provedores que nao usam versao de API.
LITELLM_EMBEDDING_API_VERSION=
LITELLM_STT_MODEL=
LITELLM_STT_API_BASE=
# Chave usada pelo proxy somente no provedor de speech-to-text.
LITELLM_STT_API_KEY=
# Opcional para provedores que nao usam versao de API.
LITELLM_STT_API_VERSION=

#### Integracao com a API do SEI
SEI_API_DB_IDENTIFIER_SERVICE=
SEI_ADDRESS=

#### Gateway HTTPS
# Nome DNS ou FQDN usado pelo SEI para acessar o gateway Nginx. Ele deve resolver
# tanto no host do SEI quanto na rede Docker compartilhada, quando as stacks estiverem
# no mesmo servidor. Este nome entra obrigatoriamente no SAN do certificado.
SEIIA_GATEWAY_HOST=
# Nomes DNS adicionais no SAN, separados por virgula. Pode permanecer vazio.
SEIIA_CERT_DNS=

#### SearXNG (profile oficial web-search)
# Gere com: openssl rand -hex 32
SEARXNG_SECRET_KEY=

#### Langfuse (opcional)
LANGFUSE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
