#### Configuracoes gerais para o SEI IA.
NB_USER="seiia"                      # Define o nome do usuario para implantacao.
NB_UID=4000                          # Define o UID (User ID).
NB_GID=4000                          # Define o GID (Group ID).
VOL_SEIIA_DIR="/var/seiia/volumes"   # Define a pasta para os volumes do SEI IA.
TZ="America/Sao_Paulo"               # Timezone padrao dos containers.
COMPOSE_NETWORK_NAME="docker-host-bridge"        # Nome da rede compartilhada do compose.
LOG_LEVEL="WARNING" # Define o nível de log de todos os outros servicos (exceto deploy)para 'ERROR', que é um dos níveis possíveis: INFO | DEBUG | WARNING | ERROR.

#### Configuracoes para o Airflow do SEI IA.
AIRFLOW__CORE__DEFAULT_TIMEZONE="America/Sao_Paulo"
AIRFLOW__CORE__EXECUTOR="CeleryExecutor"
AIRFLOW__CORE__PARALLELISM="32"
AIRFLOW__CORE__MAX_ACTIVE_TASKS_PER_DAG="16"
AIRFLOW__CORE__ALLOWED_DESERIALIZATION_CLASSES="airflow\\..*"
AIRFLOW__CORE__DAGBAG_IMPORT_TIMEOUT="300"
AIRFLOW__CORE__DAG_FILE_PROCESSOR_TIMEOUT="600"
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION="False"
AIRFLOW__CORE__TEST_CONNECTION="Enabled"
AIRFLOW__CORE__MIN_SERIALIZED_DAG_UPDATE_INTERVAL="120"
AIRFLOW__CORE__MIN_SERIALIZED_DAG_FETCH_INTERVAL="30"
AIRFLOW__WEBSERVER__DEFAULT_UI_TIMEZONE="America/Sao_Paulo"
AIRFLOW__WEBSERVER__EXPOSE_CONFIG="True"
AIRFLOW__WEBSERVER__WEB_SERVER_MASTER_TIMEOUT="600"
AIRFLOW__WEBSERVER__WORKERS="2"
AIRFLOW__CELERY__CELERY_APP_NAME="airflow.providers.celery.executors.celery_executor"
AIRFLOW__CELERY__SYNC_PARALLELISM="0"
AIRFLOW__CELERY__OPERATION_TIMEOUT="7200"
AIRFLOW__CELERY__TASK_TRACK_STARTED="True"
AIRFLOW__CELERY__TASK_PUBLISH_MAX_RETRIES="3"
AIRFLOW__CELERY__WORKER_PRECHECK="False"
AIRFLOW__CELERY__WORKER_TASK_LOG_READ_TIMEOUT="86400"
AIRFLOW__CELERY__BROKER_CONNECTION_TIMEOUT="300"
AIRFLOW__SCHEDULER__MAX_TIS_PER_QUERY="16"
AIRFLOW__SCHEDULER__PARSING_PROCESSES="1"
AIRFLOW__SCHEDULER__TASK_QUEUED_TIMEOUT="1200"
AIRFLOW__SCHEDULER__ENABLE_HEALTH_CHECK="True"
AIRFLOW__SENSORS__DEFAULT_TIMEOUT="604800"
AIRFLOW__API__AUTH_BACKENDS="airflow.api.auth.backend.basic_auth,airflow.api.auth.backend.session"
AIRFLOW__CELERY_BROKER_TRANSPORT_OPTIONS__VISIBILITY_TIMEOUT="86400"
AIRFLOW__SCHEDULER__CATCHUP_BY_DEFAULT="False"

#### Configuracoes para o Solr do SEI IA.
SOLR_HOST="infra-solr"                        # Define o nome do host interno para comunicacao com o Solr do SEI IA.
SOLR_ADDRESS="https://infra-solr:8983"        # Define o endereco da URL do Solr do SEI IA.
SOLR_MLT_JURISPRUDENCE_CORE="documentos_bm25" # Define o nome do core de documentos do Solr do SEI IA.
SOLR_MLT_PROCESS_CORE="processos_bm25"        # Define o nome do core de processos do Solr do SEI IA.
SOLR_READ_TIMEOUT_SECONDS=30                    # Timeout de leitura das consultas assíncronas ao Solr.


#### Configuracoes do banco de dados do SEI IA.
DB_SEIIA_HOST="infra-postgres"            # Host do BD do SEI IA.
DB_SEIIA_PORT="5432"                      # Porta do BD do SEI IA.
DB_SEIIA_SIMILARIDADE="sei_similaridade"  # Nome do banco de dados do SEI Similaridade.
DB_SEIIA_ASSISTENTE="SEI_LLM"             # Nome do banco de dados do Assistente.
DB_SEIIA_ASSISTENTE_SCHEMA="sei_llm"      # Nome do schema do banco de dados do Assistente.

#### Configuracoes do Assistente.
ASSISTENTE_MAX_RETRIES=3               # Numero de tentativas de comunicacao com a API do LLM.
ASSISTENTE_SEI_API_MAX_RETRIES=3       # Tentativas de transporte read-only da API do SEI.
ASSISTENTE_TIMEOUT_API=900             # Tempo de timeout em segundos para a comunicacao com a API do LLM.
ASSISTENTE_STREAMING_HEARTBEAT_INTERVAL=30 # Intervalo em segundos entre mensagens de heartbeat no streaming.
ASSISTENTE_MAX_LENGTH_CHUNK_SIZE="1512" # Quantidade maxima de tokens dos textos submetidos ao modelo de embeddings.
ASSISTENTE_CHUNK_OVERLAP="50"          # Quantidade de caracteres sobrepostos nos chunks.
ASSISTENTE_DEFAULT_RESPONSE_MODEL="principal" # Modelo padrao de resposta do assistente.
EMBEDDING_MODEL="embedding"            # Alias publico do proxy; a identidade da tabela permanece em LITELLM_EMBEDDING_MODEL.
EMBEDDING_DIM="1536"                   # Dimensao do vetor (coluna vector(N)); deve casar com o modelo acima. Fonte unica para o DDL nos dois apps.
ASSISTENTE_EMBEDDING_ENCODING_NAME="o200k_base" # Encoding usado para tokenizacao dos embeddings.
ASSISTENTE_OUTPUT_TOKENS_STANDARD_MODEL=32768 # Reserva local usada apenas pelo endpoint /stream legado.
ASSISTENTE_OUTPUT_TOKENS_MINI_MODEL=32768 # Reserva local usada apenas pelo endpoint /stream legado.
ASSISTENTE_CTX_LEN_STANDARD_MODEL=1000000 # Tamanho de contexto do modelo standard.
ASSISTENTE_CTX_LEN_MINI_MODEL=1000000    # Tamanho de contexto do modelo mini.
ASSISTENTE_SUMMARIZE_MODEL="classificador" # Categoria de modelo usada para sumarizacao.
ASSISTENTE_SUMMARIZE_CHUNK_SIZE=16000    # Tamanho de entrada de cada segmento a resumir.
ASSISTENTE_SUMMARIZE_CHUNK_MAX_OUTPUT=4000 # Tamanho maximo da saida de cada resumo.
LITELLM_PORT=4000                       # Porta interna/externa do proxy LiteLLM.
ASSISTENTE_LITELLM_PROXY_URL="http://infra-litellm:${LITELLM_PORT}" # URL interna do proxy LiteLLM (hostname = nome do servico em docker-compose.yml).
SEARX_BASE_URL="http://infra-searxng:8080"      # URL interna do SearXNG (hostname = nome do servico em docker-compose.yml).
FASTCRW_BASE_URL="http://infra-fastcrw:3000"    # URL interna do fastCRW — scraper principal da stack web-search.
BYPARR_BASE_URL="http://infra-byparr:8191"      # URL interna do Byparr — anti-bot Cloudflare/Turnstile (FlareSolverr-compatible).
MARKER_BASE_URL="http://infra-marker:8082"      # URL interna do Marker — conversão PDF → markdown.
ASSISTENTE_PORT=8088                    # Porta externa padrao publicada para o Assistente.
REDIS_URI=redis://infra-redis:6379/0    # URI do Redis compartilhado (assistente + jobs do etl-airflow). Hostname = nome do servico em docker-compose.yml.
ASSISTENTE_CACHE_TTL_SECONDS=3600       # TTL do cache Redis de documentos (1h). Documentos com SinArmazenarCache='N' sao deletados imediatamente, independente deste valor.
ASSISTENTE_CACHE_MAX_CONNECTIONS=250    # Teto do pool Redis do assistente. Subido para 250 (default 100) para aliviar contencao em burst de processamento paralelo.
ASSISTENTE_CACHE_POOL_WAIT_TIMEOUT=5    # Segundos que coroutines aguardam por conexao livre no BlockingConnectionPool antes de levantar erro.

# Sessao Deep Agents (/llm_lang/session_stream). Filesystem escopado por {id_usuario}_{id_topico} + checkpointer Postgres + TTL deslizante.
ASSISTENTE_SESSIONS_ROOT=/var/seiia/sessions   # Raiz do filesystem das sessoes no container (mapeado para o volume session_fs_vol).
ASSISTENTE_SESSION_TTL_SECONDS=3600            # TTL deslizante: a sessao expira apos N segundos de inatividade e e apagada (dir + thread do checkpointer).
ASSISTENTE_SESSION_MAX_FILE_SIZE_MB=50         # Teto por arquivo lido pelo FilesystemBackend do deepagents.
ASSISTENTE_SESSION_SWEEPER_INTERVAL_SECONDS=300 # Intervalo do sweeper que recupera sessoes abandonadas.
ASSISTENTE_SESSION_MAIN_MODEL=principal        # Agente principal.
ASSISTENTE_SESSION_EXPLORER_MODEL=explorador   # Subagentes exploradores.
ASSISTENTE_SESSION_CLASSIFIER_MODEL=classificador # Classificador de complexidade (Fase 2).
ASSISTENTE_SESSION_CHECKPOINTER_SCHEMA=seiia_session # Schema dedicado das tabelas do checkpointer no banco SEI_LLM (nao toca o schema sei_llm).
ASSISTENTE_SESSION_PREPARATION_HEARTBEAT_INTERVAL_SECONDS=30 # Mantem SSE ativo durante materializacao; deve ser muito menor que o timeout do proxy.
ASSISTENTE_SESSION_AGENT_HEARTBEAT_INTERVAL_SECONDS=30 # Mantem SSE ativo enquanto o agente aguarda o modelo; permitido entre 15 e 30s.

# Configuracoes para deploy externo.
# Ao alterar este arquivo versionado, renderize o Compose novamente e valide o runtime.
ASSISTENTE_USE_LANGFUSE=false          # Define se o Langfuse esta ativo no Assistente do SEI IA.
ASSISTENTE_LANGFUSE_TRUNCATE_PAYLOADS=true # Default seguro: limita payloads textuais enviados ao trace. Use false somente em benchmark isolado protegido.

#### Integracao com a API do SEI.
SEI_API_DB_TIMEOUT=120                 # Timeout padrao das requisicoes para a API do SEI.
SEI_API_DB_USER="Usuario_IA"           # Usuario/sigla de sistema usado na API do SEI.

### Airflow stack ###
AIRFLOW__CORE__MAX_ACTIVE_RUNS_PER_DAG=16 # Define o número máximo de execuções ativas por DAG como 16; padrão do Airflow 2.9
AIRFLOW__CELERY__WORKER_CONCURRENCY=8     # Concorrencia dos workers Celery.
AIRFLOW_WORKERS_REPLICAS=3                # Numero de replicas de workers.
AIRFLOW_WORKER_MEM_LIMIT=20g              # Limite de memoria por worker.
AIRFLOW_WORKER_CPU_LIMIT='3'              # Limite de CPU por worker.
AIRFLOW_POSTGRES_MEM_LIMIT=6g             # Limite de memoria do Postgres do Airflow.
AIRFLOW_POSTGRES_CPU_LIMIT='4'            # Limite de CPU do Postgres do Airflow.
RABBITMQ_MEM_LIMIT=2g                     # Limite de memoria do RabbitMQ.
RABBITMQ_CPU_LIMIT='1'                    # Limite de CPU do RabbitMQ.
AIRFLOW_WEBSERVER_MEM_LIMIT=2g            # Limite de memoria do webserver.
AIRFLOW_WEBSERVER_CPU_LIMIT='2'           # Limite de CPU do webserver.
AIRFLOW_SCHEDULER_MEM_LIMIT=4g            # Limite de memoria do scheduler.
AIRFLOW_SCHEDULER_CPU_LIMIT='2'           # Limite de CPU do scheduler.
AIRFLOW_SCHEDULER_CPU_SHARES='2048'       # Shares relativos de CPU do scheduler.
AIRFLOW_TRIGGERER_MEM_LIMIT=1g            # Limite de memoria do triggerer.
AIRFLOW_TRIGGERER_CPU_LIMIT='2'           # Limite de CPU do triggerer.
AIRFLOW_INIT_MEM_LIMIT=2g                 # Limite para migracoes e usuario inicial.
AIRFLOW_INIT_CPU_LIMIT='2'
ETL_AIRFLOW_API_MEM_LIMIT=4g              # Limite da API interna de jobs.
ETL_AIRFLOW_API_CPU_LIMIT='2'

### Api sei ###
API_SEI_MEM_LIMIT=4g                    # Define o limite de memória para a API do SEI.
API_SEI_CPU_LIMIT='0.5'                 # Define o limite de CPU para a API do SEI.

### App api ###
APP_API_MEM_LIMIT=512mb  # Define o limite de memória para a API do aplicativo.
APP_API_CPU_LIMIT='0.3'  # Define o limite de CPU para a API do aplicativo.

### Solr ###
SOLR_JAVA_MEM='-Xms2g -Xmx6g'    # Heap Java recomendado para o perfil de referencia.
SOLR_MEM_LIMIT=8g                 # Limite do container, com margem fora do heap Java.
SOLR_CPU_LIMIT='8'                # Limite de CPU do Solr.

### Pgvector ###
PGVECTOR_MEM_LIMIT=16g  # Limite de memoria para o BD.
PGVECTOR_CPU_LIMIT='4'  # Limite de CPU para o BD.

### Assistente ###
ASSISTENTE_MEM_LIMIT=6gb             # Limite de memoria do Assistente.
ASSISTENTE_CPU_LIMIT='4'             # Limite de CPU do Assistente.
GATEWAY_NGINX_MEM_LIMIT=4gb          # Limite de memoria do gateway Nginx.
GATEWAY_NGINX_CPU_LIMIT='6'          # Limite de CPU do gateway Nginx.
STACK_CONFIG_CHECKER_MEM_LIMIT=2g    # Limite para o checker sob demanda.
STACK_CONFIG_CHECKER_CPU_LIMIT='1'
ASSISTENTE_FATOR_LIMITAR_RAG="4"     # Fator usado para reservar contexto durante a recuperacao de documentos.
OCR_MAX_CONCURRENT_PAGES=15 # Numero maximo de paginas OCR processadas em paralelo


### Geracao de embeddings
EMBEDDING_MAX_ACTIVE_RUNS="10"

### Limites de recursos para o LiteLLM Proxy
LITELLM_CPU_LIMIT='2'
LITELLM_MEM_LIMIT=8g

### Redis
REDIS_CPU_LIMIT='1'
REDIS_MEM_LIMIT=2g

### SearXNG
SEARXNG_MEM_LIMIT=512mb  # Define o limite de memória para o SearXNG.
SEARXNG_CPU_LIMIT='1'    # Define o limite de CPU para o SearXNG.

### web-search stack (profile: web-search)
FASTCRW_MEM_LIMIT=2g    # fastCRW — orquestrador de scraping.
FASTCRW_CPU_LIMIT='2'
LIGHTPANDA_MEM_LIMIT=2g # LightPanda — browser leve (Zig) para JS leve/médio.
LIGHTPANDA_CPU_LIMIT='2'
CHROME_MEM_LIMIT=2g     # Chrome headless — browser pesado para SPAs complexas.
CHROME_CPU_LIMIT='2'
BYPARR_MEM_LIMIT=2g     # Byparr — anti-bot Camoufox para Cloudflare/Turnstile.
BYPARR_CPU_LIMIT='1'
MARKER_MEM_LIMIT=2g     # Marker — conversão PDF → markdown (pymupdf4llm, sem GPU).
MARKER_CPU_LIMIT='2'
