# =============================================================================
# SEI-IA Assistente - Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env e preencha os valores adequados
# =============================================================================

# -----------------------------------------------------------------------------
# CONFIGURAÇÕES GERAIS
# -----------------------------------------------------------------------------
TZ=America/Sao_Paulo
LOG_LEVEL=INFO                          # critical|error|warning|info|debug|trace

# -----------------------------------------------------------------------------
# BANCO DE DADOS POSTGRESQL (PGVECTOR)
# -----------------------------------------------------------------------------
DB_SEIIA_HOST=pgvector_assistente
DB_SEIIA_PORT=5432
DB_SEIIA_USER=
# Defina DB_SEIIA_PWD no security.env da raiz.
DB_SEIIA_ASSISTENTE=SEI_LLM
DB_SEIIA_ASSISTENTE_SCHEMA=sei_llm


# -----------------------------------------------------------------------------
# API SEI (Acesso ao banco de dados do SEI)
# -----------------------------------------------------------------------------
SEI_ADDRESS=
SEI_API_DB_ADDRESS=
SEI_API_DB_IDENTIFIER_SERVICE=
SEI_API_DB_USER=Usuario_IA
SEI_API_DB_TIMEOUT=120
ASSISTENTE_SEI_API_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# REDIS CACHE
# -----------------------------------------------------------------------------
REDIS_URI=redis://infra-redis:6379/0
ASSISTENTE_CACHE_ENABLED=true
ASSISTENTE_CACHE_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# SESSAO DEEP AGENTS (/llm_lang/session_stream)
# -----------------------------------------------------------------------------
ASSISTENTE_SESSIONS_ROOT=/var/seiia/sessions   # raiz do filesystem das sessoes (volume persistente)
ASSISTENTE_SESSION_TTL_SECONDS=3600            # TTL deslizante: expira apos N seg de inatividade
ASSISTENTE_SESSION_MAX_FILE_SIZE_MB=50
ASSISTENTE_SESSION_SWEEPER_INTERVAL_SECONDS=300
ASSISTENTE_SESSION_MAIN_MODEL=principal        # agente principal
ASSISTENTE_SESSION_EXPLORER_MODEL=explorador   # subagentes exploradores
ASSISTENTE_SESSION_CLASSIFIER_MODEL=classificador  # classificador de complexidade (Fase 2)
ASSISTENTE_SESSION_CHECKPOINTER_SCHEMA=seiia_session  # schema dedicado no banco SEI_LLM
ASSISTENTE_SESSION_PREPARATION_HEARTBEAT_INTERVAL_SECONDS=30 # status SSE durante materializacao longa
ASSISTENTE_SESSION_AGENT_HEARTBEAT_INTERVAL_SECONDS=30 # heartbeat SSE enquanto o agente aguarda o modelo (15-30s)
# Exclusivo de harness isolado; vazio em dev/producao normal.
ASSISTENTE_SESSION_BENCHMARK_EVIDENCE_INDEX=

# -----------------------------------------------------------------------------
# LANGFUSE (Observabilidade)
# -----------------------------------------------------------------------------
LANGFUSE_URL=http://langfuse_assistente:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
ASSISTENTE_USE_LANGFUSE=true
# Default true; false mantém texto integral no trace, mas preserva redaction de mídia.
# Use o opt-out apenas em benchmark isolado com artefatos protegidos.
ASSISTENTE_LANGFUSE_TRUNCATE_PAYLOADS=true

# -----------------------------------------------------------------------------
# LITELLM PROXY (Conexao com modelos LLM)
# -----------------------------------------------------------------------------
# O LiteLLM Proxy gerencia toda a comunicacao com Azure OpenAI/outros providers.
# Configurar o proxy separadamente com as credenciais dos modelos.
ASSISTENTE_LITELLM_PROXY_URL=http://localhost:4000
ASSISTENTE_LITELLM_PROXY_API_KEY= # Obrigatoria quando o proxy exige autenticacao

# Nomes físicos usados como model/base_model no litellm_config (preenchidos pelo
# CI/CD). A aplicação sempre envia os aliases públicos fixos standard, mini,
# nano, embedding e speech-to-text ao proxy.
LITELLM_STANDARD_MODEL=
LITELLM_MINI_MODEL=
LITELLM_NANO_MODEL=
LITELLM_STT_MODEL=

# -----------------------------------------------------------------------------
# MODELO DE EMBEDDINGS (via LiteLLM Proxy)
# -----------------------------------------------------------------------------
# Base_model físico; também participa da identidade da tabela pgvector.
LITELLM_EMBEDDING_MODEL=
ASSISTENTE_EMBEDDING_MODEL=text-embedding-3-small
ASSISTENTE_MAX_LENGTH_CHUNK_SIZE=1512
ASSISTENTE_CHUNK_OVERLAP=50

# -----------------------------------------------------------------------------
# CONFIGURACOES DE CONTEXTO E OUTPUT DOS MODELOS
# -----------------------------------------------------------------------------
# Estas variaveis controlam os limites de tokens para cada tipo de modelo.
# Os nomes reais dos modelos (gpt-4.1, gpt-5.1, etc.) sao configurados no proxy.

# Modelo STANDARD
ASSISTENTE_OUTPUT_TOKENS_STANDARD_MODEL=32768 # Usado apenas pelo endpoint /stream legado.
ASSISTENTE_CTX_LEN_STANDARD_MODEL=250000

# Modelo MINI
ASSISTENTE_OUTPUT_TOKENS_MINI_MODEL=32000 # Usado apenas pelo endpoint /stream legado.
ASSISTENTE_CTX_LEN_MINI_MODEL=250000

# Modelo NANO (opcional)
ASSISTENTE_OUTPUT_TOKENS_NANO_MODEL=30000 # Usado apenas pelo endpoint /stream legado.
ASSISTENTE_CTX_LEN_NANO_MODEL=128000

# -----------------------------------------------------------------------------
# DEPRECATED - Variaveis abaixo NAO sao mais utilizadas
# -----------------------------------------------------------------------------
# Apos migracao para LiteLLM Proxy, as API keys e endpoints sao gerenciados
# pelo proxy. Mantenha estas variaveis comentadas.
#
# ASSISTENTE_API_KEY_STANDARD_MODEL=
# ASSISTENTE_ENDPOINT_STANDARD_MODEL=
# ASSISTENTE_NAME_STANDARD_MODEL=
# ASSISTENTE_API_KEY_MINI_MODEL=
# ASSISTENTE_ENDPOINT_MINI_MODEL=
# ASSISTENTE_NAME_MINI_MODEL=
# ASSISTENTE_API_KEY_NANO_MODEL=
# ASSISTENTE_ENDPOINT_NANO_MODEL=
# ASSISTENTE_NAME_NANO_MODEL=
# ASSISTENTE_EMBEDDING_API_KEY=
# ASSISTENTE_EMBEDDING_ENDPOINT=
# ASSISTENTE_EMBEDDING_PROVIDER=

# -----------------------------------------------------------------------------
# CONFIGURAÇÕES DE TIMEOUT E PERFORMANCE
# -----------------------------------------------------------------------------
ASSISTENTE_TIMEOUT_API=900
ASSISTENTE_TIMEOUT_GET_DOC=120
ASSISTENTE_MAX_RETRIES=3
ASSISTENTE_REQUESTS_PER_SECOND=30.0

# -----------------------------------------------------------------------------
# CONFIGURAÇÕES DE SUMARIZAÇÃO
# -----------------------------------------------------------------------------
ASSISTENTE_SUMMARIZE_MODEL=classificador
ASSISTENTE_SUMMARIZE_CHUNK_SIZE=16000
ASSISTENTE_SUMMARIZE_CHUNK_MAX_OUTPUT=4000

# -----------------------------------------------------------------------------
# CONFIGURAÇÕES DA APLICAÇÃO
# -----------------------------------------------------------------------------
ASSISTENTE_PORT=8088
ASSISTENTE_DEFAULT_RESPONSE_MODEL=principal
