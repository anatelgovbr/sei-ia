COMPOSE_NETWORK_NAME=seiia-bench-1428-net
ASSISTENTE_PORT=8188
# Trace textual integral somente nesta stack protegida; mídia continua redactada.
ASSISTENTE_LANGFUSE_TRUNCATE_PAYLOADS=false
# Curto apenas no harness para tornar heartbeat observavel sem alterar producao.
ASSISTENTE_SESSION_PREPARATION_HEARTBEAT_INTERVAL_SECONDS=1
# Apenas para a instância interna, sem porta publicada. Não usar em produção.
SEARXNG_SECRET_KEY=isolated-benchmark-placeholder-not-a-secret
ASSISTENTE_SESSION_WEBRESEARCH_EVIDENCE_GATE_ENABLED=false
ASSISTENTE_SESSION_WEBRESEARCH_EVIDENCE_GATE_INPUT_CHARS=24000
